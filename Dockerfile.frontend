# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: Build the Vite/React app
#
# Build context is the REPO ROOT (same as Dockerfile.api / Dockerfile.worker):
#   docker build -f Dockerfile.frontend -t video-frontend:latest .
#
# The previous version copied ./package.json and ran `npm run build` against it.
# From the repo root that is the BACKEND manifest — it has no `build` script and
# no Vite, so the build died at `npm run build`. The React app lives in frontend/.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /build

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: Serve static files with Nginx
# ─────────────────────────────────────────────────────────────────────────────
FROM nginx:alpine

LABEL maintainer="video-stream-engine"
LABEL service="frontend"

# Remove default Nginx page
RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /build/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
